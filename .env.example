# Local runtime
CINENODE_HOME=./data
CINENODE_HOST=127.0.0.1
CINENODE_PORT=8787
CINENODE_MAX_UPLOAD_BYTES=8589934592
CINENODE_COMMAND_TIMEOUT_SECONDS=14400
CINENODE_ALLOW_SHUTDOWN=true
CINENODE_ALLOW_LOOPBACK_PROXY=false

# Optional custom paths
CINENODE_MODELS_DIR=./data/models
CINENODE_ENGINES_DIR=./data/engines
# CINENODE_FRONTEND_DIR=./source/backend/cinenode/frontend
# CINENODE_DB=./data/cinenode.sqlite3

# Optional setup-only token for gated Hugging Face files. Never commit a real value.
HF_TOKEN=

# Optional local LLM / service URLs
OLLAMA_HOST=http://127.0.0.1:11434

# Optional cloud providers. Leave empty to keep the app fully local.
FREEPIK_API_KEY=
REPLICATE_API_TOKEN=
FAL_KEY=
TRIPO_API_KEY=
GENERIC_PROVIDER_API_KEY=

# Optional generic REST provider endpoint is configured in Settings; never place
# the secret itself in settings.json, only GENERIC_PROVIDER_API_KEY here.
